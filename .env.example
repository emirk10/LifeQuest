# LifeQuest Global Environment Variables

# PostgreSQL Database Settings
DB_HOST=db
DB_PORT=5432
DB_NAME=LifeQuestDB
DB_USER=postgres
DB_PASSWORD=your_strong_password_here

# API Settings
API_PORT=5020
API_URL=http://localhost:5020

# Frontend Settings
FRONTEND_PORT=5173

# AI Service Settings
AI_SERVICE_PORT=5001
AI_SERVICE_URL=http://ai_service:5001
AI_SERVICE_API_KEY=LifeQuestAiSecretKey123

# pgAdmin Settings
PGADMIN_DEFAULT_EMAIL=admin@lifequest.com
PGADMIN_DEFAULT_PASSWORD=admin_password_here

# JWT Secret
JWT_SECRET=your_jwt_secret_key_at_least_64_bytes_long_here

# SMTP Settings (MailHog)
SMTP_HOST=mailhog
SMTP_PORT=1025
